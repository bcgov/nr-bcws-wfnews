{
  "name": "wfnews-e2e",
  "private": true,
  "version": "0.0.0",
  "description": "Device tests for the WFNEWS mobile app. WebdriverIO with Appium.",
  "scripts": {
    "test": "wdio run wdio.conf.ts",
    "test:permissions": "wdio run wdio.conf.ts --spec test/specs/location-permission.e2e.ts",
    "test:screens": "wdio run wdio.conf.ts --spec test/specs/screens.e2e.ts",
    "driver:install": "appium driver install uiautomator2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@wdio/appium-service": "^9.31.0",
    "@wdio/cli": "^9.31.0",
    "@wdio/globals": "^9.31.0",
    "@wdio/local-runner": "^9.31.0",
    "@wdio/mocha-framework": "^9.31.0",
    "@wdio/spec-reporter": "^9.31.0",
    "appium": "^3.6.0",
    "appium-uiautomator2-driver": "^8.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
