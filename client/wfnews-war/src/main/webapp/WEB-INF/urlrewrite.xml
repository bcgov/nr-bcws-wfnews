<urlrewrite>
	<rule match-type="regex" enabled="true">
		<condition type="request-filename" operator="notfile" />
		<condition type="request-filename" operator="notdir" />
		<condition type="request-uri" operator="notequal">(\.html|\.js|\.png|\.gif|\.jpg|\.css|\.svg|\.ico|\.wav|\.woff|\.woff2|\.ttf|\.json)</condition>
		<condition type="request-uri" operator="notequal">^/\.well-known/.*$</condition>
		<condition type="request-uri" operator="notequal">^/youtube-embed.*$</condition>
		<from>^/(.*)$</from>
		<to last="true">/index.html</to>
	</rule>
</urlrewrite>