                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import java.util.Random
Random random = new Random()

def response = new groovy.json.JsonSlurper().parse(prev.getResponseData())

def request = [:]
def length = response.features.size()

def index1 = random.nextInt(length - 1)
def index2 = random.nextInt(length - 1)
def index3 = random.nextInt(length - 1)

vars.put(&apos;fire_year1&apos;, response.features[index1].properties.fire_year.toString())
vars.put(&apos;incident_number_label1&apos;, response.features[index1].properties.incident_number_label)
vars.put(&apos;fire_year2&apos;, response.features[index2].properties.fire_year.toString())
vars.put(&apos;incident_number_label2&apos;, response.features[index2].properties.incident_number_label)
vars.put(&apos;fire_year3&apos;, response.features[index3].properties.fire_year.toString())
vars.put(&apos;incident_number_label3&apos;, response.features[index3].properties.incident_number_label)</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PostProcessor>
