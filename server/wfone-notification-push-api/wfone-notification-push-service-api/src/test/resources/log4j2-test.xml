<?xml version="1.0" encoding="UTF-8"?>
<!-- Test only. It makes the push worker log visible when a test runs. -->
<Configuration status="WARN">
	<Appenders>
		<Console name="Console" target="SYSTEM_OUT">
			<PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level %logger{1} - %msg%n"/>
		</Console>
	</Appenders>
	<Loggers>
		<Logger name="ca.bc.gov.nrs.wfone.notification.push" level="INFO"/>
		<Root level="WARN">
			<AppenderRef ref="Console"/>
		</Root>
	</Loggers>
</Configuration>
